 "frases": [
  {
   "txt": "Lembra da primeira cena?",
   "ini": 0.0,
   "fim": 1.56
  },
  {
   "txt": "Esta é a linha do tempo deste vídeo.",
   "ini": 1.78,
   "fim": 4.01
  },
  {
   "txt": "Dez cenas, cinco passos:",
   "ini": 4.23,
   "fim": 5.78
  },
  {
   "txt": "preparar, entender, cortar, animar e finalizar.",
   "ini": 6.0,
   "fim": 8.73
  },
  {
   "txt": "E nenhum programa de edição aberto.",
   "ini": 8.95,
   "fim": 11.05
  },
  {
   "txt": "Eu não substituo o seu olhar.",
   "ini": 11.27,
   "fim": 13.0
  },
  {
   "txt": "Eu tiro da sua frente a parte repetitiva, para sobrar tempo para a parte que é sua:",
   "ini": 13.22,
   "fim": 18.01
  },
  {
   "txt": "a ideia.",
   "ini": 18.23,
   "fim": 18.97
  },
  {
   "txt": "Eu corto, você decide.",
   "ini": 19.19,
   "fim": 20.8
  },
  {
   "txt": "E isso vale até para canal dark, aquele que não mostra o rosto de ninguém.",
   "ini": 21.02,
   "fim": 24.98
  },
  {
   "txt": "Mas isso é assunto para outro vídeo.",
   "ini": 25.2,
   "fim": 27.28
  },
  {
   "txt": "Começa pequeno.",
   "ini": 27.5,
   "fim": 28.62
  },
  {
   "txt": "Pega um vídeo, cria a pasta e escreve o primeiro pedido.",
   "ini": 28.84,
   "fim": 32.01
  },
  {
   "txt": "Agora me diz:",
   "ini": 32.23,
   "fim": 33.3
  },
  {
   "txt": "quer ver eu tirando cortes de um vídeo, ou montando um vídeo inteiro do zero, na sua frente?",
   "ini": 33.52,
   "fim": 38.51
  },
  {
   "txt": "Comenta 1 para os cortes, 2 para o vídeo inteiro.",
   "ini": 38.73,
   "fim": 41.44
  },
  {
   "txt": "E se este vídeo te ajudou, se inscreve.",
   "ini": 41.66,
   "fim": 44.02
  },
  {
   "txt": "Valeu, galera.",
   "ini": 44.24,
   "fim": 45.28
  },
  {
   "txt": "Até a próxima.",
   "ini": 45.5,
   "fim": 46.62
  },
  {
   "txt": "Fui!",
   "ini": 46.84,
   "fim": 47.37
  }
 ],
