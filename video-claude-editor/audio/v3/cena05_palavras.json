 "frases": [
  {
   "txt": "Tudo que se mexe neste vídeo é código.",
   "ini": 0.0,
   "fim": 2.42
  },
  {
   "txt": "Este personagem, esta linha do tempo, este movimento de câmera.",
   "ini": 2.64,
   "fim": 6.28
  },
  {
   "txt": "Código é só texto com instruções, como uma receita:",
   "ini": 6.5,
   "fim": 9.45
  },
  {
   "txt": "cada linha diz o que fazer e quando.",
   "ini": 9.67,
   "fim": 11.78
  },
  {
   "txt": "A ferramenta se chama Remotion.",
   "ini": 12.0,
   "fim": 13.98
  },
  {
   "txt": "Ela transforma código em vídeo.",
   "ini": 14.2,
   "fim": 16.33
  },
  {
   "txt": "Em vez de arrastar um texto com o mouse, eu escrevo:",
   "ini": 16.55,
   "fim": 19.46
  },
  {
   "txt": "este título entra no segundo três, cresce, e a câmera se aproxima.",
   "ini": 19.68,
   "fim": 23.26
  },
  {
   "txt": "O Remotion desenha quadro por quadro e entrega o vídeo.",
   "ini": 23.48,
   "fim": 26.65
  },
  {
   "txt": "O seu pedido é este:",
   "ini": 26.87,
   "fim": 28.35
  },
  {
   "txt": "\"Coloque legenda palavra por palavra neste vídeo, em branco e no centro, e faça o título da abertura entrar no segundo três.\" Olha a prova, cara.",
   "ini": 28.57,
   "fim": 36.74
  },
  {
   "txt": "Esta é a abertura deste vídeo.",
   "ini": 36.96,
   "fim": 38.85
  },
  {
   "txt": "E este é o código dela.",
   "ini": 39.07,
   "fim": 40.7
  },
  {
   "txt": "Eu mudo um número aqui, e o personagem muda de lugar ali.",
   "ini": 40.92,
   "fim": 44.13
  },
  {
   "txt": "Para você, isso vira três coisas.",
   "ini": 44.35,
   "fim": 46.35
  },
  {
   "txt": "Legendas palavra por palavra, no tempo certo, porque eu já tenho o tempo de cada palavra desde o passo dois.",
   "ini": 46.57,
   "fim": 52.7
  },
  {
   "txt": "Textos e gráficos que aparecem na hora em que você fala deles.",
   "ini": 52.92,
   "fim": 56.5
  },
  {
   "txt": "E mudar qualquer coisa leva uma frase.",
   "ini": 56.72,
   "fim": 59.05
  },
  {
   "txt": "Não gostou da cor?",
   "ini": 59.27,
   "fim": 60.43
  },
  {
   "txt": "Quer a legenda maior?",
   "ini": 60.65,
   "fim": 62.18
  },
  {
   "txt": "Você pede e eu refaço o vídeo inteiro.",
   "ini": 62.4,
   "fim": 64.71
  },
  {
   "txt": "Mas Claude, eu não sei programar.",
   "ini": 64.93,
   "fim": 66.97
  },
  {
   "txt": "Não precisa, ok?",
   "ini": 67.19,
   "fim": 68.52
  },
  {
   "txt": "Você só precisa descrever o que quer ver.",
   "ini": 68.74,
   "fim": 71.18
  },
  {
   "txt": "E quanto mais claro for o pedido, melhor sai a cena.",
   "ini": 71.4,
   "fim": 74.39
  },
  {
   "txt": "Falta só uma coisa:",
