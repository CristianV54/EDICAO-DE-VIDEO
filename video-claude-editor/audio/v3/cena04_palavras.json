 "frases": [
  {
   "txt": "Duas ferramentas fazem o corte.",
   "ini": 0.0,
   "fim": 2.01
  },
  {
   "txt": "A primeira é o auto-editor.",
   "ini": 2.23,
   "fim": 3.97
  },
  {
   "txt": "Ele mede o volume do áudio e remove sozinho os trechos de silêncio.",
   "ini": 4.19,
   "fim": 8.01
  },
  {
   "txt": "A pausa para pensar, a respiração antes de começar, o tempo morto entre uma frase e outra.",
   "ini": 8.23,
   "fim": 13.49
  },
  {
   "txt": "Some tudo.",
   "ini": 13.71,
   "fim": 14.57
  },
  {
   "txt": "A segunda é o FFmpeg.",
   "ini": 14.79,
   "fim": 16.49
  },
  {
   "txt": "Ele corta o vídeo, junta trechos e muda o formato do arquivo.",
   "ini": 16.71,
   "fim": 20.12
  },
  {
   "txt": "Não tem botão nem tela, só comandos escritos.",
   "ini": 20.34,
   "fim": 23.06
  },
  {
   "txt": "E quem escreve sou eu.",
   "ini": 23.28,
   "fim": 24.83
  },
  {
   "txt": "O seu pedido é este:",
   "ini": 25.05,
   "fim": 26.53
  },
  {
   "txt": "\"Tire os silêncios e os erros deste vídeo, mas me mostre a lista de cortes antes de cortar.\" Aí, antes de a gente cortar qualquer coisa, eu te mostro a lista, tá?",
   "ini": 26.75,
   "fim": 35.82
  },
  {
   "txt": "\"Vou tirar este erro aos dois minutos.",
   "ini": 36.04,
   "fim": 38.2
  },
  {
   "txt": "Vou tirar esta repetição aos sete.\" Você lê, muda o que quiser e aprova.",
   "ini": 38.42,
   "fim": 42.42
  },
  {
   "txt": "Só então eu corto.",
   "ini": 42.64,
   "fim": 43.98
  },
  {
   "txt": "E como eu sei o tempo de cada palavra, eu corto entre uma palavra e outra, não no meio de uma.",
   "ini": 44.2,
   "fim": 49.36
  },
  {
   "txt": "Resultado:",
   "ini": 49.58,
   "fim": 50.55
  },
  {
   "txt": "uma gravação crua de vinte minutos pode virar doze, por exemplo.",
   "ini": 50.77,
   "fim": 54.45
  },
  {
   "txt": "Sem você arrastar nada.",
   "ini": 54.67,
   "fim": 56.29
  },
  {
   "txt": "Prefere dar o acabamento com as próprias mãos?",
   "ini": 56.51,
   "fim": 59.27
  },
  {
   "txt": "O auto-editor entrega a linha do tempo já cortada, para abrir no seu programa de edição.",
   "ini": 59.49,
   "fim": 64.4
  },
  {
   "txt": "Agora uma confissão:",
   "ini": 64.62,
   "fim": 65.88
  },
  {
   "txt": "a abertura deste vídeo ficou ruim na primeira versão.",
   "ini": 66.1,
   "fim": 69.21
  },
  {
   "txt": "No passo cinco eu te mostro o que aconteceu depois.",
   "ini": 69.43,
   "fim": 72.49
  },
  {
   "txt": "Se está valendo a pena até aqui, se inscreve.",
   "ini": 72.71,
   "fim": 75.15
  },
  {
   "txt": "O vídeo está limpo.",
   "ini": 75.37,
   "fim": 76.72
  },
  {
   "txt": "Mas limpo não é o mesmo que bom de assistir.",
   "ini": 76.94,
   "fim": 79.52
  },
  {
   "txt": "Falta o que você está vendo agora.",
   "ini": 79.74,
   "fim": 81.7
  }
