{
 "voz": "pm_alex",
 "duracao": 61.8,
 "frases": [
  {
   "txt": "Você escreve:",
   "ini": 0.0,
   "fim": 1.02
  },
  {
   "txt": "\"exporte o vídeo final\".",
   "ini": 1.24,
   "fim": 2.76
  },
  {
   "txt": "Eu junto os cortes, as animações e a música, e gero um arquivo pronto para o YouTube.",
   "ini": 2.98,
   "fim": 7.62
  },
  {
   "txt": "Depois eu confiro.",
   "ini": 7.84,
   "fim": 9.26
  },
  {
   "txt": "Resolução, duração, volume do áudio.",
   "ini": 9.48,
   "fim": 11.64
  },
  {
   "txt": "E tiro fotos de vários pontos do vídeo para procurar tela preta, texto cortado ou legenda fora do lugar.",
   "ini": 11.86,
   "fim": 17.89
  },
  {
   "txt": "Aí vem a parte mais importante do processo inteiro:",
   "ini": 18.11,
   "fim": 21.07
  },
  {
   "txt": "você assiste.",
   "ini": 21.29,
   "fim": 22.39
  },
  {
   "txt": "E me fala o que sentiu.",
   "ini": 22.61,
   "fim": 24.08
  },
  {
   "txt": "\"O começo está lento.\" \"Esta parte ficou confusa.\" \"A música está alta aqui.\" Eu corrijo e exporto de novo.",
   "ini": 24.3,
   "fim": 30.06
  },
  {
   "txt": "Foi assim com a abertura deste vídeo.",
   "ini": 30.28,
   "fim": 32.53
  },
  {
   "txt": "Em cada versão, o Cristian assistiu e disse o que incomodava.",
   "ini": 32.75,
   "fim": 36.25
  },
  {
   "txt": "Linha do tempo deitada.",
   "ini": 36.47,
   "fim": 38.04
  },
  {
   "txt": "Cor demais.",
   "ini": 38.26,
   "fim": 39.15
  },
  {
   "txt": "Câmera parada.",
   "ini": 39.37,
   "fim": 40.42
  },
  {
   "txt": "Eu não adivinho o seu gosto.",
   "ini": 40.64,
   "fim": 42.42
  },
  {
   "txt": "Eu aprendo com o que você me fala.",
   "ini": 42.64,
   "fim": 44.57
  },
  {
   "txt": "Eu sou rápido, mas o gosto é seu.",
   "ini": 44.79,
   "fim": 46.8
  },
  {
   "txt": "Quem decide se o vídeo está bom é você.",
   "ini": 47.02,
   "fim": 49.39
  },
  {
   "txt": "E como eu já li o vídeo inteiro, eu também entrego o que vai em volta dele:",
   "ini": 49.61,
   "fim": 53.89
  },
  {
   "txt": "ideias de título, a descrição e os capítulos com o tempo certo.",
   "ini": 54.11,
   "fim": 57.7
  },
  {
   "txt": "Esses são os cinco passos.",
   "ini": 57.92,
   "fim": 59.45
  },
  {
   "txt": "Agora, os dois jeitos de usar.",
   "ini": 59.67,
   "fim": 61.58
  }
 ],
