  {
   "txt": "Primeira:",
   "ini": 0.0,
   "fim": 0.74
  },
  {
   "txt": "aprove a lista antes do corte.",
   "ini": 0.96,
   "fim": 2.87
  },
  {
   "txt": "É o que faz o vídeo ser seu, e não só meu.",
   "ini": 3.09,
   "fim": 5.33
  },
  {
   "txt": "Segunda:",
