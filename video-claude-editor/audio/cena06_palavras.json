{
 "voz": "pm_alex",
 "duracao": 66.11,
 "frases": [
  {
   "txt": "Você escreve:",
   "ini": 0.0,
   "fim": 1.02
  },
  {
   "txt": "\"exporte o vídeo final\".",
   "ini": 1.24,
   "fim": 2.76
  },
  {
   "txt": "Eu junto os cortes, as animações e a música, e gero um arquivo pronto para o YouTube.",
   "ini": 2.98,
   "fim": 7.62
  },
  {
   "txt": "Depois eu confiro.",
   "ini": 7.84,
   "fim": 9.26
  },
  {
   "txt": "O tamanho da imagem, a duração, o volume do áudio.",
   "ini": 9.48,
   "fim": 12.29
  },
  {
   "txt": "E tiro fotos de vários pontos do vídeo para procurar tela preta, texto cortado ou legenda fora do lugar.",
   "ini": 12.51,
   "fim": 18.54
  },
  {
   "txt": "Aí vem a parte mais importante do processo inteiro, entende?",
   "ini": 18.76,
   "fim": 22.27
  },
  {
   "txt": "Você assiste.",
   "ini": 22.49,
   "fim": 23.59
  },
  {
   "txt": "E me fala o que sentiu.",
   "ini": 23.81,
   "fim": 25.27
  },
  {
   "txt": "\"O começo está lento.\" \"Esta parte ficou confusa.\" \"A música está alta aqui.\" Eu corrijo e exporto de novo.",
   "ini": 25.49,
   "fim": 31.26
  },
  {
   "txt": "Foi assim com a abertura deste vídeo.",
   "ini": 31.48,
   "fim": 33.73
  },
  {
   "txt": "A cada versão, o Cristian, que me empresta a voz, assistiu e disse o que incomodava.",
   "ini": 33.95,
   "fim": 38.54
  },
  {
   "txt": "A primeira tinha a linha do tempo deitada, de lado.",
   "ini": 38.76,
   "fim": 41.43
  },
  {
   "txt": "A segunda ficou colorida demais.",
   "ini": 41.65,
   "fim": 43.71
  },
  {
   "txt": "Mas Claude, por que você não acerta de primeira?",
   "ini": 43.93,
   "fim": 46.71
  },
  {
   "txt": "Porque eu não adivinho o seu gosto.",
   "ini": 46.93,
   "fim": 48.97
  },
  {
   "txt": "Eu aprendo com o que você me fala.",
   "ini": 49.19,
   "fim": 51.11
  },
  {
   "txt": "Quem decide se o vídeo está bom é você.",
   "ini": 51.33,
   "fim": 53.7
  },
  {
   "txt": "E como eu já li o vídeo inteiro, eu também entrego o que vai em volta dele:",
   "ini": 53.92,
   "fim": 58.21
  },
  {
   "txt": "ideias de título, a descrição e os capítulos com o tempo certo.",
   "ini": 58.43,
   "fim": 62.02
  },
  {
   "txt": "Esses são os cinco passos.",
   "ini": 62.24,
   "fim": 63.76
  },
  {
   "txt": "Agora, os dois jeitos de usar.",
   "ini": 63.98,
   "fim": 65.89
  }
 ],
