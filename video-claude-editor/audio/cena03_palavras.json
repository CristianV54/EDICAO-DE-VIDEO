{
 "voz": "pm_alex",
 "duracao": 61.71,
 "frases": [
  {
   "txt": "Aqui está o segredo de tudo:",
   "ini": 0.0,
   "fim": 1.89
  },
  {
   "txt": "eu não assisto o seu vídeo como você assiste.",
   "ini": 2.11,
   "fim": 4.81
  },
  {
   "txt": "Eu leio.",
   "ini": 5.03,
   "fim": 5.72
  },
  {
   "txt": "A ferramenta se chama Whisper.",
   "ini": 5.94,
   "fim": 7.82
  },
  {
   "txt": "É um programa gratuito, que roda no seu computador.",
   "ini": 8.04,
   "fim": 10.73
  },
  {
   "txt": "Ele ouve o áudio e devolve o texto de tudo que foi dito, com o momento em que cada palavra foi falada.",
   "ini": 10.95,
   "fim": 16.79
  },
  {
   "txt": "Você escreve:",
   "ini": 17.01,
   "fim": 18.02
  },
  {
   "txt": "\"transcreva este vídeo palavra por palavra\".",
   "ini": 18.24,
   "fim": 20.84
  },
  {
   "txt": "E um vídeo de uma hora vira um texto.",
   "ini": 21.06,
   "fim": 23.07
  },
  {
   "txt": "Depois de pronto, eu leio em segundos.",
   "ini": 23.29,
   "fim": 25.54
  },
  {
   "txt": "É como ter a legenda do filme na mão, né?",
   "ini": 25.76,
   "fim": 28.06
  },
  {
   "txt": "Em vez de assistir o filme inteiro para achar uma cena.",
   "ini": 28.28,
   "fim": 31.38
  },
  {
   "txt": "Lendo, eu enxergo o vídeo inteiro de uma vez.",
   "ini": 31.6,
   "fim": 34.26
  },
  {
   "txt": "Onde você errou e repetiu a frase.",
   "ini": 34.48,
   "fim": 36.73
  },
  {
   "txt": "Onde ficou cinco segundos em silêncio.",
   "ini": 36.95,
   "fim": 39.38
  },
  {
   "txt": "Onde a explicação ficou boa.",
   "ini": 39.6,
   "fim": 41.38
  },
  {
   "txt": "Onde tem uma frase forte, que dá um corte.",
   "ini": 41.6,
   "fim": 44.11
  },
  {
   "txt": "E quando o que importa é a imagem, eu tiro fotos do vídeo nos momentos certos e olho para elas.",
   "ini": 44.33,
   "fim": 49.71
  },
  {
   "txt": "No fim deste passo, você recebe um mapa:",
   "ini": 49.93,
   "fim": 52.35
  },
  {
   "txt": "o que sai, o que fica e os melhores momentos, marcados.",
   "ini": 52.57,
   "fim": 55.61
  },
  {
   "txt": "Para um vídeo ou para cinquenta, o pedido é o mesmo.",
   "ini": 55.83,
   "fim": 58.76
  },
  {
   "txt": "Com o mapa pronto, cortar vira a parte fácil.",
   "ini": 58.98,
   "fim": 61.49
  }
