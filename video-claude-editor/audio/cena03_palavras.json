 "frases": [
  {
   "txt": "Aqui está o segredo de tudo:",
   "ini": 0.0,
   "fim": 1.89
  },
  {
   "txt": "eu não assisto o seu vídeo como você assiste.",
   "ini": 2.11,
   "fim": 4.81
  },
  {
   "txt": "Eu leio.",
   "ini": 5.03,
   "fim": 5.72
  },
  {
   "txt": "A ferramenta se chama Whisper.",
   "ini": 5.94,
   "fim": 7.82
  },
  {
   "txt": "É um programa gratuito, que funciona no seu computador.",
   "ini": 8.04,
   "fim": 10.88
  },
  {
   "txt": "Ele ouve o áudio e devolve o texto de tudo que foi dito.",
   "ini": 11.1,
   "fim": 14.45
  },
  {
   "txt": "E não é só o texto:",
   "ini": 14.67,
   "fim": 16.0
  },
  {
   "txt": "cada palavra vem com o momento em que foi falada.",
   "ini": 16.22,
   "fim": 18.99
  },
  {
   "txt": "Você escreve:",
   "ini": 19.21,
   "fim": 20.23
  },
  {
   "txt": "\"transcreva este vídeo palavra por palavra\".",
   "ini": 20.45,
   "fim": 23.04
  },
  {
   "txt": "E um vídeo de uma hora vira um texto que eu leio em segundos.",
   "ini": 23.26,
   "fim": 26.43
  },
  {
   "txt": "Quando eu leio, eu enxergo o vídeo inteiro de uma vez.",
   "ini": 26.65,
   "fim": 29.58
  },
  {
   "txt": "Onde você errou e repetiu a frase.",
   "ini": 29.8,
   "fim": 32.05
  },
  {
   "txt": "Onde ficou cinco segundos em silêncio.",
   "ini": 32.27,
   "fim": 34.7
  },
  {
   "txt": "Onde a explicação ficou boa.",
   "ini": 34.92,
   "fim": 36.7
  },
  {
   "txt": "Onde tem uma frase forte, que daria um corte.",
   "ini": 36.92,
   "fim": 39.62
  },
  {
   "txt": "E quando o que importa é a imagem, eu tiro fotos do vídeo nos momentos certos e olho para elas.",
   "ini": 39.84,
   "fim": 45.23
  },
  {
   "txt": "No fim deste passo, você recebe um mapa:",
   "ini": 45.45,
   "fim": 47.86
  },
  {
   "txt": "o que sai, o que fica, e os melhores momentos, marcados.",
   "ini": 48.08,
   "fim": 51.23
  },
  {
   "txt": "Funciona para um vídeo ou para cinquenta.",
   "ini": 51.45,
   "fim": 53.8
  },
  {
   "txt": "O pedido é o mesmo.",
   "ini": 54.02,
   "fim": 55.44
  },
  {
   "txt": "Com o mapa pronto, cortar vira a parte fácil.",
   "ini": 55.66,
   "fim": 58.18
  }
