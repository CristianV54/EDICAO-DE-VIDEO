  {
   "txt": "Lembra que eu prometi falar o valor?",
   "ini": 0.0,
   "fim": 2.14
  },
  {
   "txt": "Bora, a gente faz a conta.",
   "ini": 2.36,
   "fim": 4.07
  },
  {
   "txt": "As quatro ferramentas:",
   "ini": 4.29,
   "fim": 5.78
  },
  {
   "txt": "zero, para quem trabalha sozinho.",
   "ini": 6.0,
   "fim": 7.92
  },
  {
   "txt": "O único custo desta lista é o Claude.",
   "ini": 8.14,
   "fim": 10.43
  },
  {
   "txt": "O Claude Code vem no plano Pro, que custa vinte dólares por mês, ou dezessete no plano anual.",
   "ini": 10.65,
   "fim": 15.9
  },
  {
   "txt": "É em dólar, então o cartão converte para reais.",
   "ini": 16.12,
   "fim": 18.95
  },
  {
   "txt": "Agora tira um print.",
   "ini": 19.17,
   "fim": 20.48
  },
  {
   "txt": "E o que não funciona, porque eu não vendo milagre.",
   "ini": 20.7,
   "fim": 23.28
  },
  {
   "txt": "A minha primeira versão quase nunca é a boa:",
   "ini": 23.5,
   "fim": 25.95
  },
  {
   "txt": "você viu isso na abertura.",
   "ini": 26.17,
   "fim": 27.91
  },
  {
   "txt": "Se o seu pedido for vago, o corte sai genérico.",
   "ini": 28.13,
   "fim": 30.98
  },
  {
   "txt": "E o plano tem um limite de uso, que você confere na página dele.",
   "ini": 31.2,
   "fim": 34.94
  },
  {
   "txt": "Então sobra para você a parte que importa:",
   "ini": 35.16,
   "fim": 37.62
  },
  {
   "txt": "a ideia.",
   "ini": 37.84,
   "fim": 38.58
  },
  {
   "txt": "Eu volto nisso no final.",
   "ini": 38.8,
   "fim": 40.35
  }
