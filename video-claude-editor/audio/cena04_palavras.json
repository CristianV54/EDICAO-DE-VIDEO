 "frases": [
  {
   "txt": "Nível dois.",
   "ini": 0.0,
   "fim": 0.93
  },
  {
   "txt": "Cortes.",
   "ini": 1.15,
   "fim": 1.84
  },
  {
   "txt": "A meta:",
   "ini": 2.06,
   "fim": 2.73
  },
  {
   "txt": "dez cortes verticais, com legenda, tirados de um vídeo só.",
   "ini": 2.95,
   "fim": 6.4
  },
  {
   "txt": "Você tem um podcast, uma aula, uma live.",
   "ini": 6.62,
   "fim": 9.22
  },
  {
   "txt": "O seu pedido:",
   "ini": 9.44,
   "fim": 10.56
  },
  {
   "txt": "\"Encontre os dez melhores trechos deste vídeo, com até um minuto cada, corte na vertical e coloque legenda palavra por palavra.\" Eu leio o texto do vídeo e escolho trechos que funcionam sozinhos, com começo e fim.",
   "ini": 10.78,
   "fim": 22.62
  },
  {
   "txt": "Dez cortes, uma frase.",
   "ini": 22.84,
   "fim": 24.43
  },
  {
   "txt": "E a legenda, quem faz?",
   "ini": 24.65,
   "fim": 26.18
  },
  {
   "txt": "Uma ferramenta chamada Remotion, grátis para quem trabalha sozinho ou em até três pessoas.",
   "ini": 26.4,
   "fim": 31.7
  },
  {
   "txt": "Ela transforma código em vídeo.",
   "ini": 31.92,
   "fim": 34.04
  },
  {
   "txt": "Código é só texto com instruções, como uma receita:",
   "ini": 34.26,
   "fim": 37.22
  },
  {
   "txt": "cada linha diz o que fazer e quando.",
   "ini": 37.44,
   "fim": 39.55
  },
  {
   "txt": "Eu escrevo que a palavra acende na hora em que é falada, e eu já sei o tempo de cada palavra desde o Whisper.",
   "ini": 39.77,
   "fim": 45.96
  },
  {
   "txt": "Mas Claude, e se você escolher o trecho errado?",
   "ini": 46.18,
   "fim": 48.74
  },
  {
   "txt": "Por isso a dica:",
   "ini": 48.96,
   "fim": 50.08
  },
  {
   "txt": "peça para eu explicar por que escolhi cada um.",
   "ini": 50.3,
   "fim": 52.72
  },
  {
   "txt": "Você aprova antes de eu gerar o arquivo final.",
   "ini": 52.94,
   "fim": 55.57
  },
  {
   "txt": "Meta do nível dois batida:",
   "ini": 55.79,
   "fim": 57.64
  },
  {
   "txt": "um vídeo longo virou dez peças curtas.",
   "ini": 57.86,
   "fim": 60.13
  },
  {
   "txt": "Agora o nível três.",
   "ini": 60.35,
   "fim": 61.62
  },
  {
   "txt": "Esse é o que eu fiz com o vídeo que você está vendo.",
   "ini": 61.84,
   "fim": 64.57
  }
 ],
