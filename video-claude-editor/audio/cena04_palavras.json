 "frases": [
  {
   "txt": "Duas ferramentas fazem o corte.",
   "ini": 0.0,
   "fim": 2.01
  },
  {
   "txt": "A primeira é o auto-editor.",
   "ini": 2.23,
   "fim": 3.97
  },
  {
   "txt": "Ela mede o volume do áudio e remove sozinha os trechos de silêncio.",
   "ini": 4.19,
   "fim": 8.08
  },
  {
   "txt": "A pausa para pensar, a respiração antes de começar, o tempo morto entre uma frase e outra.",
   "ini": 8.3,
   "fim": 13.57
  },
  {
   "txt": "Some tudo.",
   "ini": 13.79,
   "fim": 14.65
  },
  {
   "txt": "A segunda é o FFmpeg.",
   "ini": 14.87,
   "fim": 16.56
  },
  {
   "txt": "É o motor que está por trás de boa parte dos vídeos da internet.",
   "ini": 16.78,
   "fim": 20.38
  },
  {
   "txt": "Ele corta no ponto exato, junta trechos, muda o formato, ajusta o som.",
   "ini": 20.6,
   "fim": 24.55
  },
  {
   "txt": "Não tem botão nem tela, só comandos.",
   "ini": 24.77,
   "fim": 27.04
  },
  {
   "txt": "E quem escreve os comandos sou eu.",
   "ini": 27.26,
   "fim": 29.26
  },
  {
   "txt": "Mas antes de cortar qualquer coisa, eu te mostro a lista.",
   "ini": 29.48,
   "fim": 32.75
  },
  {
   "txt": "\"Vou tirar este erro aos dois minutos.",
   "ini": 32.97,
   "fim": 35.14
  },
  {
   "txt": "Vou tirar esta repetição aos sete.\" Você lê, muda o que quiser e aprova.",
   "ini": 35.36,
   "fim": 39.35
  },
  {
   "txt": "Só então eu corto.",
   "ini": 39.57,
   "fim": 40.91
  },
  {
   "txt": "E como eu sei o tempo de cada palavra, o corte acontece entre uma palavra e outra.",
   "ini": 41.13,
   "fim": 45.94
  },
  {
   "txt": "Nunca no meio.",
   "ini": 46.16,
   "fim": 47.16
  },
  {
   "txt": "Resultado:",
   "ini": 47.38,
   "fim": 48.35
  },
  {
   "txt": "um bruto de vinte minutos vira doze, sem você arrastar nada.",
   "ini": 48.57,
   "fim": 52.12
  },
  {
   "txt": "E se você prefere dar o acabamento com as próprias mãos, o auto-editor entrega a linha do tempo já cortada para abrir no seu programa de edição.",
   "ini": 52.34,
   "fim": 60.49
  },
  {
   "txt": "E aqui vem a parte que quase ninguém conta:",
   "ini": 60.71,
   "fim": 63.26
  },
  {
   "txt": "a abertura deste vídeo ficou ruim na primeira versão.",
   "ini": 63.48,
   "fim": 66.59
  },
  {
   "txt": "E na segunda.",
   "ini": 66.81,
   "fim": 67.89
  },
  {
   "txt": "O Cristian me mandou refazer várias vezes.",
   "ini": 68.11,
   "fim": 70.76
  },
  {
   "txt": "No passo cinco eu te mostro por que isso faz parte do processo.",
   "ini": 70.98,
   "fim": 74.53
  },
  {
   "txt": "Se está valendo a pena até aqui, se inscreve.",
   "ini": 74.75,
   "fim": 77.18
  },
  {
   "txt": "O vídeo está limpo.",
   "ini": 77.4,
   "fim": 78.76
  },
  {
   "txt": "Mas limpo não é o mesmo que bom de assistir.",
   "ini": 78.98,
   "fim": 81.55
  },
  {
   "txt": "Falta o que você está vendo agora.",
   "ini": 81.77,
   "fim": 83.73
  }
