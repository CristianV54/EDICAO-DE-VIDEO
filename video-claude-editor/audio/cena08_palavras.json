 "frases": [
  {
   "txt": "Lembra da primeira cena?",
   "ini": 0.0,
   "fim": 1.56
  },
  {
   "txt": "Esta é a linha do tempo deste vídeo.",
   "ini": 1.78,
   "fim": 4.01
  },
  {
   "txt": "Oito cenas, três níveis:",
   "ini": 4.23,
   "fim": 5.84
  },
  {
   "txt": "limpar, cortar e montar o vídeo inteiro.",
   "ini": 6.06,
   "fim": 8.33
  },
  {
   "txt": "E nenhum programa de edição aberto.",
   "ini": 8.55,
   "fim": 10.65
  },
  {
   "txt": "Eu não substituo o seu olhar.",
   "ini": 10.87,
   "fim": 12.6
  },
  {
   "txt": "Eu tiro da sua frente a parte repetitiva, para sobrar tempo para a parte que é sua:",
   "ini": 12.82,
   "fim": 17.6
  },
  {
   "txt": "a ideia.",
   "ini": 17.82,
   "fim": 18.56
  },
  {
   "txt": "Eu corto, você decide.",
   "ini": 18.78,
   "fim": 20.39
  },
  {
   "txt": "E isso vale até para canal dark, aquele que não mostra o rosto de ninguém.",
   "ini": 20.61,
   "fim": 24.58
  },
  {
   "txt": "Mas isso é assunto para outro vídeo.",
   "ini": 24.8,
   "fim": 26.87
  },
  {
   "txt": "Não deixa para depois, cara.",
   "ini": 27.09,
   "fim": 28.81
  },
  {
   "txt": "Começa pelo nível um, hoje, com um vídeo só.",
   "ini": 29.03,
   "fim": 31.46
  },
  {
   "txt": "Abre a aba Code, cria a pasta e escreve o primeiro pedido.",
   "ini": 31.68,
   "fim": 34.89
  },
  {
   "txt": "O link do aplicativo está aqui na descrição.",
   "ini": 35.11,
   "fim": 37.77
  },
  {
   "txt": "Agora me responde:",
   "ini": 37.99,
   "fim": 39.36
  },
  {
   "txt": "qual nível você quer ver comigo, passo a passo, na tela?",
   "ini": 39.58,
   "fim": 42.63
  },
  {
   "txt": "Comenta 1, 2 ou 3.",
   "ini": 42.85,
   "fim": 44.44
  },
  {
   "txt": "E se este vídeo te ajudou, se inscreve e ativa o sininho.",
   "ini": 44.66,
   "fim": 47.71
  },
  {
   "txt": "Valeu, galera.",
   "ini": 47.93,
   "fim": 48.97
  },
  {
   "txt": "Até a próxima.",
   "ini": 49.19,
   "fim": 50.31
  },
  {
   "txt": "Fui!",
   "ini": 50.53,
   "fim": 51.06
  }
