 "frases": [
  {
   "txt": "Primeiro, esquece o Claude do chat.",
   "ini": 0.0,
   "fim": 2.04
  },
  {
   "txt": "No chat, você pergunta e eu respondo com texto.",
   "ini": 2.26,
   "fim": 5.02
  },
  {
   "txt": "Só isso.",
   "ini": 5.24,
   "fim": 5.98
  },
  {
   "txt": "Para editar vídeo, você precisa do Claude Code.",
   "ini": 6.2,
   "fim": 9.25
  },
  {
   "txt": "A diferença, cara, é simples.",
   "ini": 9.47,
   "fim": 11.4
  },
  {
   "txt": "No Claude Code, eu trabalho dentro de uma pasta do seu computador.",
   "ini": 11.62,
   "fim": 15.56
  },
  {
   "txt": "Eu abro arquivos, instalo programas e executo comandos, quer dizer, ordens escritas para o computador.",
   "ini": 15.78,
   "fim": 21.56
  },
  {
   "txt": "Você pede, eu faço.",
   "ini": 21.78,
   "fim": 23.31
  },
  {
   "txt": "A gente prepara tudo em três movimentos.",
   "ini": 23.53,
   "fim": 25.99
  },
  {
   "txt": "Se liga.",
   "ini": 26.21,
   "fim": 26.92
  },
  {
   "txt": "Um:",
   "ini": 27.14,
   "fim": 27.62
  },
  {
   "txt": "instala o aplicativo do Claude e abre a aba Code.",
   "ini": 27.84,
   "fim": 30.94
  },
  {
   "txt": "Ela vem nos planos pagos, e o link está na descrição.",
   "ini": 31.16,
   "fim": 34.06
  },
  {
   "txt": "Dois:",
   "ini": 34.28,
   "fim": 34.86
  },
  {
   "txt": "cria uma pasta e arrasta os seus vídeos brutos para dentro.",
   "ini": 35.08,
   "fim": 38.55
  },
  {
   "txt": "Bruto é a gravação crua, do jeito que saiu da câmera.",
   "ini": 38.77,
   "fim": 41.65
  },
  {
   "txt": "Três:",
   "ini": 41.87,
   "fim": 42.44
  },
  {
   "txt": "escolhe essa pasta no aplicativo e escreve:",
   "ini": 42.66,
   "fim": 45.27
  },
  {
   "txt": "\"prepare esta pasta para edição de vídeo\".",
   "ini": 45.49,
   "fim": 48.0
  },
  {
   "txt": "Pronto.",
   "ini": 48.22,
   "fim": 48.85
  },
  {
   "txt": "Daqui eu assumo.",
   "ini": 49.07,
   "fim": 50.21
  },
  {
   "txt": "Eu instalo as ferramentas, que você vai conhecer nos próximos passos, e divido a pasta em três:",
   "ini": 50.43,
   "fim": 55.78
  },
  {
   "txt": "bruto, trabalho e pronto.",
   "ini": 56.0,
   "fim": 57.65
  },
  {
   "txt": "Você não instala nenhuma ferramenta à mão.",
   "ini": 57.87,
   "fim": 60.33
  },
  {
   "txt": "Mas Claude, e se você estragar o meu vídeo?",
   "ini": 60.55,
   "fim": 62.98
  },
  {
   "txt": "Não estraga, ok?",
   "ini": 63.2,
   "fim": 64.51
  },
  {
   "txt": "Os seus originais ficam trancados na pasta bruto.",
   "ini": 64.73,
   "fim": 67.7
  },
  {
   "txt": "Todo corte vira um arquivo novo.",
   "ini": 67.92,
   "fim": 69.97
  },
  {
   "txt": "Não gostou, é só pedir de novo.",
   "ini": 70.19,
   "fim": 72.23
  },
  {
   "txt": "E antes de falar de ferramenta:",
   "ini": 72.45,
   "fim": 74.45
  },
  {
   "txt": "as quatro que eu uso são grátis para quem trabalha sozinho.",
   "ini": 74.67,
   "fim": 77.88
  },
  {
   "txt": "O que custa dinheiro é outra coisa, e eu falo no fim.",
   "ini": 78.1,
   "fim": 81.14
  },
  {
   "txt": "Só que tem um problema.",
   "ini": 81.36,
   "fim": 82.85
  },
  {
   "txt": "Eu ainda não sei o que tem dentro do seu vídeo.",
   "ini": 83.07,
   "fim": 85.76
  },
  {
   "txt": "E é isso que o passo dois resolve.",
