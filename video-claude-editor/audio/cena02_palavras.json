 "frases": [
  {
   "txt": "Primeiro, esquece o Claude do chat.",
   "ini": 0.0,
   "fim": 2.04
  },
  {
   "txt": "No chat, você pergunta e eu respondo com texto.",
   "ini": 2.26,
   "fim": 5.02
  },
  {
   "txt": "Para editar vídeo, você precisa do Claude Code.",
   "ini": 5.24,
   "fim": 8.29
  },
  {
   "txt": "A diferença é simples:",
   "ini": 8.51,
   "fim": 10.08
  },
  {
   "txt": "no Claude Code, eu trabalho dentro de uma pasta do seu computador.",
   "ini": 10.3,
   "fim": 14.24
  },
  {
   "txt": "Eu abro arquivos, instalo programas e executo comandos.",
   "ini": 14.46,
   "fim": 17.67
  },
  {
   "txt": "Você pede, eu faço.",
   "ini": 17.89,
   "fim": 19.42
  },
  {
   "txt": "A preparação tem três movimentos.",
   "ini": 19.64,
   "fim": 21.84
  },
  {
   "txt": "Um:",
   "ini": 22.06,
   "fim": 22.55
  },
  {
   "txt": "instale o aplicativo do Claude e abra a aba Code.",
   "ini": 22.77,
   "fim": 25.89
  },
  {
   "txt": "Ela faz parte dos planos pagos, e o link está na descrição.",
   "ini": 26.11,
   "fim": 29.4
  },
  {
   "txt": "Dois:",
   "ini": 29.62,
   "fim": 30.2
  },
  {
   "txt": "crie uma pasta e arraste os seus vídeos brutos para dentro dela.",
   "ini": 30.42,
   "fim": 34.0
  },
  {
   "txt": "Três:",
   "ini": 34.22,
   "fim": 34.79
  },
  {
   "txt": "escolha essa pasta dentro do aplicativo e escreva:",
   "ini": 35.01,
   "fim": 38.01
  },
  {
   "txt": "\"prepare esta pasta para edição de vídeo\".",
   "ini": 38.23,
   "fim": 40.74
  },
  {
   "txt": "A partir daqui, eu assumo.",
   "ini": 40.96,
   "fim": 42.51
  },
  {
   "txt": "Eu instalo as ferramentas, que você vai conhecer nos próximos passos, e organizo a pasta em três partes:",
   "ini": 42.73,
   "fim": 48.6
  },
  {
   "txt": "bruto, trabalho e pronto.",
   "ini": 48.82,
   "fim": 50.47
  },
  {
   "txt": "Um detalhe importante:",
   "ini": 50.69,
   "fim": 52.05
  },
  {
   "txt": "os seus originais ficam guardados.",
   "ini": 52.27,
   "fim": 54.42
  },
  {
   "txt": "Todo corte gera um arquivo novo.",
   "ini": 54.64,
   "fim": 56.71
  },
  {
   "txt": "Se você não gostar, é só pedir de novo.",
   "ini": 56.93,
   "fim": 59.35
  },
  {
   "txt": "E antes de eu falar de ferramenta:",
   "ini": 59.57,
   "fim": 61.61
  },
  {
   "txt": "as quatro que eu uso são gratuitas para quem trabalha sozinho.",
   "ini": 61.83,
   "fim": 65.15
  },
  {
   "txt": "O que custa dinheiro é outra coisa, e eu te falo o valor exato no final.",
   "ini": 65.37,
   "fim": 69.52
  },
  {
   "txt": "Só que existe um problema.",
