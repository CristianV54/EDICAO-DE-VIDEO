 "frases": [
  {
   "txt": "Tudo que se mexe neste vídeo é código.",
   "ini": 0.0,
   "fim": 2.42
  },
  {
   "txt": "Este personagem, esta linha do tempo, este movimento de câmera.",
   "ini": 2.64,
   "fim": 6.28
  },
  {
   "txt": "A ferramenta é o Remotion.",
   "ini": 6.5,
   "fim": 8.23
  },
  {
   "txt": "Ela transforma código em vídeo.",
   "ini": 8.45,
   "fim": 10.57
  },
  {
   "txt": "Em vez de arrastar um texto com o mouse, eu escrevo:",
   "ini": 10.79,
   "fim": 13.71
  },
  {
   "txt": "este título entra no segundo três, cresce, e a câmera se aproxima.",
   "ini": 13.93,
   "fim": 17.51
  },
  {
   "txt": "O Remotion desenha quadro por quadro e entrega o vídeo.",
   "ini": 17.73,
   "fim": 20.89
  },
  {
   "txt": "Olha a prova.",
   "ini": 21.11,
   "fim": 22.06
  },
  {
   "txt": "Esta é a abertura deste vídeo.",
   "ini": 22.28,
   "fim": 24.17
  },
  {
   "txt": "E este é o código dela.",
   "ini": 24.39,
   "fim": 26.02
  },
  {
   "txt": "Eu mudo um número aqui, e o personagem muda de lugar ali.",
   "ini": 26.24,
   "fim": 29.45
  },
  {
   "txt": "Para você, isso significa três coisas.",
   "ini": 29.67,
   "fim": 31.97
  },
  {
   "txt": "Legendas palavra por palavra, no tempo certo, porque eu já tenho o tempo de cada palavra desde o passo dois.",
   "ini": 32.19,
   "fim": 38.32
  },
  {
   "txt": "Textos e gráficos que aparecem na hora exata em que você fala deles.",
   "ini": 38.54,
   "fim": 42.44
  },
  {
   "txt": "E mudanças em uma frase.",
   "ini": 42.66,
   "fim": 44.3
  },
  {
   "txt": "Não gostou da cor?",
   "ini": 44.52,
   "fim": 45.68
  },
  {
   "txt": "Quer a legenda maior?",
   "ini": 45.9,
   "fim": 47.43
  },
  {
   "txt": "Você pede e eu refaço o vídeo inteiro.",
   "ini": 47.65,
   "fim": 49.96
  },
  {
   "txt": "Você não precisa entender o código.",
   "ini": 50.18,
   "fim": 52.58
  },
  {
   "txt": "Precisa saber descrever o que quer ver.",
   "ini": 52.8,
   "fim": 55.06
  },
  {
   "txt": "Quanto mais claro o pedido, melhor a cena.",
   "ini": 55.28,
   "fim": 57.66
  },
  {
   "txt": "Falta só uma coisa:",
   "ini": 57.88,
   "fim": 59.23
  },
  {
