{
  "name": "pecas-fotografo",
  "version": "1.0.0",
  "description": "Video vertical animado em 3D: As 13 pecas do fotografo (Remotion + React Three Fiber)",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "tempos": "node scripts/gerar-tempos.mjs",
    "stills": "node scripts/gerar-stills.mjs",
    "render": "remotion render PecasFotografo out/pecas-fotografo.mp4 --gl=swangle --codec=h264 --crf=20",
    "previa": "remotion render PecasFotografo out/previa-sem-audio.mp4 --gl=swangle --scale=0.5 --crf=26"
  },
