    "@remotion/cli": "^4.0.0",
    "@remotion/install-whisper-cpp": "^4.0.539",
    "@remotion/layout-utils": "^4.0.539",
    "@remotion/media": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@remotion/zod-types": "^4.0.0",
    "mediabunny": "1.62.0",
    "react": "19.2.3",
